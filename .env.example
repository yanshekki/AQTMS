# =============================================
# AQTMS Environment Variables Example
# Copy this file to .env and fill in your values
# =============================================

# Application
NODE_ENV=development
PORT=3000

# Database (Prisma)
# Example for PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/aqtms?schema=public"

# Exchange Provider (BINANCE or BYBIT)
EXCHANGE_PROVIDER=BINANCE

# Binance API (Recommended to use Testnet first)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=true

# Bybit API (Optional)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=true

# Kill Switch / Risk Management
DAILY_LOSS_LIMIT=500

# WebSocket / Real-time (optional advanced settings)
# WEBSOCKET_RECONNECT_MAX_ATTEMPTS=10
