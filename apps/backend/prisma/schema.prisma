// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// NOTE (Step 1): Relations for DataSource and AuditLog on User model have been added.
// Run `pnpm prisma generate` and `pnpm prisma migrate dev` after merging this branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ... (rest of schema remains the same as previous fix)

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  role          String   @default("VIEWER")
  permissions   String[] @default([])
  nonce         String?  // for EIP-191 auth
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exchangeAccounts   ExchangeAccount[]
  trades             Trade[]
  orders             Order[]
  positions          Position[]
  signals            Signal[]
  backtestReports    BacktestReport[]
  executionLogs      ExecutionLog[]
  portfolioSnapshots PortfolioSnapshot[]
  scoringRules       ScoringRule[]
  notifications      Notification[]
  riskRules          RiskRule[]
  dataSources        DataSource[]
  auditLogs          AuditLog[]
}

// ... (other models unchanged from previous merge)
