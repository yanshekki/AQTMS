// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// AQTMS Core Models - Prisma Schema (Step 1 Complete)
// Hexagonal + DDD aligned. All models support RBAC, audit, encryption where needed.
// Expanded for full trading pipeline: User -> ExchangeAccount -> Order/Position/Trade
// Risk, Signal, Backtest, Notification, Snapshot support.
// =============================================

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  role          String   @default("VIEWER")
  permissions   String[] @default([])
  nonce         String?  // for EIP-191 auth
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exchangeAccounts   ExchangeAccount[]
  trades             Trade[]
  orders             Order[]
  positions          Position[]
  signals            Signal[]
  backtestReports    BacktestReport[]
  executionLogs      ExecutionLog[]
  portfolioSnapshots PortfolioSnapshot[]
  scoringRules       ScoringRule[]
  notifications      Notification[]
  riskRules          RiskRule[]
}

model ExchangeAccount {
  id          String   @id @default(cuid())
  userId      String
  exchange    String   // BINANCE | BYBIT | etc.
  apiKey      String   // encrypted with AES-256-GCM
  apiSecret   String   // encrypted
  isPaperTrading Boolean @default(true)
  paperVirtualBalance Float  @default(10000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  orders Order[]
  positions Position[]
  trades Trade[]

  @@index([userId])
  @@index([exchange])
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String
  side              String   // BUY | SELL
  type              String   // MARKET | LIMIT | STOP_LOSS | TAKE_PROFIT
  quantity          Float
  price             Float?
  stopLoss          Float?
  takeProfit        Float?
  status            String   @default("PENDING") // PENDING | FILLED | PARTIALLY_FILLED | CANCELLED | REJECTED
  isPaper           Boolean  @default(true)
  filledQuantity    Float    @default(0)
  avgFillPrice      Float?
  exchangeOrderId   String?  // Real exchange order ID for reconciliation & partial fills
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([userId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

model Position {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String
  quantity          Float    @default(0)
  avgPrice          Float    @default(0)
  unrealizedPnl     Float    @default(0)
  realizedPnl       Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([userId])
  @@index([exchangeAccountId])
  @@unique([exchangeAccountId, symbol])
  @@index([symbol])
}

model Trade {
  id              String   @id @default(cuid())
  userId          String
  exchangeAccountId String
  symbol          String
  side            String   // BUY | SELL
  type            String   // MARKET | LIMIT
  quantity        Float
  price           Float?
  status          String   @default("PENDING") // PENDING | FILLED | PARTIALLY_FILLED | CANCELLED
  isPaper         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([userId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([createdAt])
}

model Signal {
  id          String   @id @default(cuid())
  userId      String?
  source      String   // e.g. AI_MODEL, TELEGRAM, X_TWITTER, NEWS_API
  symbol      String
  action      String   // BUY | SELL | HOLD
  score       Float
  confidence  Float?
  metadata    Json?
  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([symbol])
  @@index([timestamp])
  @@index([score])
}

model NewsEvent {
  id          String   @id @default(cuid())
  source      String   // TELEGRAM | X | NEWS_API etc.
  content     String   @db.Text
  symbol      String?
  score       Float?
  aiAnalysis  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source])
  @@index([symbol])
  @@index([createdAt])
}

model BacktestReport {
  id          String   @id @default(cuid())
  userId      String
  strategy    String
  symbol      String
  params      Json
  metrics     Json     // { sharpe, totalReturn, maxDrawdown, winRate, ... }
  equityCurve Json?    // array of {time, value}
  trades      Json?    // executed trades in backtest
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([strategy])
}

model ExecutionLog {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  action    String   // PLACE_ORDER | CANCEL_ORDER | FILL | RISK_CHECK | KILL_SWITCH etc.
  details   Json
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  userId     String
  totalValue Float
  positions  Json     // [{symbol, quantity, avgPrice, currentPrice, pnl}]
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
}

model ScoringRule {
  id        String   @id @default(cuid())
  userId    String
  name      String
  weights   Json     // { truth: 0.3, sentiment: 0.4, ... }
  threshold Float
  action    String   // BUY | SELL | HOLD
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([name])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([read])
}

// RiskRule for configurable risk engine (Phase 1+)
model RiskRule {
  id        String   @id @default(cuid())
  userId    String
  name      String
  params    Json     // e.g. { maxPositionPct: 0.1, dailyLossLimit: 500, atrMultiplier: 2 }
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([name])
}
