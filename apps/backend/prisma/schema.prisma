// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models for AQTMS (expand in later phases)

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  role          String   @default("VIEWER") // SUPER_ADMIN | ADMIN | TRADER | ANALYST | VIEWER
  permissions   String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations (add later)
  // trades      Trade[]
  // etc.
}

model ExchangeAccount {
  id          String   @id @default(cuid())
  userId      String
  exchange    String   // BINANCE | BYBIT | etc.
  apiKey      String   // encrypted with AES-256-GCM
  apiSecret   String   // encrypted
  isPaperTrading Boolean @default(true)
  paperVirtualBalance Float  @default(10000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Trade {
  id              String   @id @default(cuid())
  userId          String
  exchangeAccountId String
  symbol          String
  side            String   // BUY | SELL
  type            String   // MARKET | LIMIT
  quantity        Float
  price           Float?
  status          String   @default("PENDING") // PENDING | FILLED | PARTIALLY_FILLED | CANCELLED
  isPaper         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([exchangeAccountId])
}

// Add more models: NewsEvent, BacktestReport, ScoringRule, Notification, ExecutionLog, PortfolioSnapshot etc. in later steps