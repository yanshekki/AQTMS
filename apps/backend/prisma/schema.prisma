// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  role          String   @default("VIEWER")
  permissions   String[] @default([])
  nonce         String?  // for EIP-191 auth
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exchangeAccounts   ExchangeAccount[]
  trades             Trade[]
  orders             Order[]
  positions          Position[]
  signals            Signal[]
  backtestReports    BacktestReport[]
  executionLogs      ExecutionLog[]
  portfolioSnapshots PortfolioSnapshot[]
  scoringRules       ScoringRule[]
  notifications      Notification[]
  riskRules          RiskRule[]
  dataSources        DataSource[]
  auditLogs          AuditLog[]
}

model ExchangeAccount {
  id                  String   @id @default(cuid())
  userId              String
  name                String?
  exchange            String
  testnet             Boolean  @default(false)
  apiKey              String
  apiSecret           String
  apiKeyEncrypted     String?
  apiSecretEncrypted  String?
  status              String   @default("ACTIVE")
  isPaperTrading      Boolean  @default(true)
  paperVirtualBalance Float    @default(10000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  orders Order[]
  positions Position[]
  trades Trade[]

  @@index([userId])
  @@index([exchange])
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String
  side              String
  type              String
  quantity          Float
  price             Float?
  stopLoss          Float?
  takeProfit        Float?
  status            String   @default("PENDING")
  isPaper           Boolean  @default(true)
  filledQuantity    Float    @default(0)
  avgFillPrice      Float?
  exchangeOrderId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([userId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

model Position {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String
  quantity          Float    @default(0)
  avgPrice          Float    @default(0)
  unrealizedPnl     Float    @default(0)
  realizedPnl       Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([userId])
  @@index([exchangeAccountId])
  @@unique([exchangeAccountId, symbol])
  @@index([symbol])
}

model Trade {
  id                String   @id @default(cuid())
  userId            String
  exchangeAccountId String
  symbol            String
  side              String
  type              String
  quantity          Float
  price             Float?
  stopPrice         Float?
  timeInForce       String?
  filledQuantity    Float    @default(0)
  exchangeOrderId   String?
  idempotencyKey    String?  @unique
  status            String   @default("PENDING")
  isPaper           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([userId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([createdAt])
}

model Signal {
  id          String   @id @default(cuid())
  userId      String?
  source      String
  symbol      String
  action      String
  score       Float
  confidence  Float?
  metadata    Json?
  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([symbol])
  @@index([timestamp])
  @@index([score])
}

model NewsEvent {
  id          String   @id @default(cuid())
  sourceId    String?
  source      String
  language    String?
  content     String   @db.Text
  symbol      String?
  score       Float?
  truthScore  Float?     // AI truth/reliability score
  aiAnalysis  String?  @db.Text
  isProcessed Boolean  @default(false)
  isFake      Boolean  @default(false)
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source])
  @@index([symbol])
  @@index([createdAt])
  @@index([isProcessed])
  @@unique([source, sourceId])
}

model BacktestReport {
  id             String   @id @default(cuid())
  userId         String
  strategy       String
  symbol         String
  params         Json
  parameters     Json?
  metrics        Json
  equityCurve    Json?
  drawdownCurve  Json?
  monthlyReturns Json?
  startDate      DateTime?
  endDate        DateTime?
  trades         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([strategy])
}

model ExecutionLog {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  action    String
  details   Json
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  userId     String
  totalValue Float
  positions  Json
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
}

model ScoringRule {
  id        String   @id @default(cuid())
  userId    String
  name      String
  weights   Json
  threshold Float
  action    String
  status    String   @default("ACTIVE")
  version   Int      @default(1)
  versions  Json?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([name])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  targetRoute String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([read])
}

model RiskRule {
  id        String   @id @default(cuid())
  userId    String
  name      String
  params    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([name])
}

model DataSource {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String
  config         Json
  status         String   @default("ACTIVE")
  lastError      String?
  lastFetchedAt  DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  details    Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}
