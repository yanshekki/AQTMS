{
  "dashboard": {
    "title": "AQTMS Production - Full Monitoring",
    "uid": "aqtms-prod-full",
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "title": "Kill Switch Status",
        "type": "stat",
        "targets": [ { "expr": "kill_switch_active", "legendFormat": "Active" } ]
      },
      {
        "title": "Execution Latency (p95)",
        "type": "graph",
        "targets": [ { "expr": "histogram_quantile(0.95, rate(execution_duration_seconds_bucket[5m]))" } ]
      },
      {
        "title": "Paper vs Live Orders Ratio",
        "type": "piechart",
        "targets": [ { "expr": "sum by (mode) (rate(orders_total[5m]))" } ]
      },
      {
        "title": "Risk Score Distribution",
        "type": "heatmap",
        "targets": [ { "expr": "risk_score" } ]
      },
      {
        "title": "Reconciliation Discrepancies (last 24h)",
        "type": "stat",
        "targets": [ { "expr": "increase(reconciliation_discrepancies_total[24h])" } ]
      },
      {
        "title": "Daily PnL Trend",
        "type": "graph",
        "targets": [ { "expr": "daily_pnl" } ]
      },
      {
        "title": "Active Positions Count",
        "type": "stat",
        "targets": [ { "expr": "active_positions" } ]
      }
    ]
  }
}