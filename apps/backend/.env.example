// Backend .env template — copy to .env and fill in values
NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://user:password@localhost:3306/aqtms
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── AI Providers (required for MVP news → scoring → trade pipeline) ──
# You need at least Grok or DeepSeek or Gemini for the multi-AI system to work

# xAI Grok (recommended for verifyTruth)
GROK_API_KEY=xai-your-key-here
GROK_MODEL=grok-2

# DeepSeek (recommended for makeDecision)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini (recommended for scoreNews)
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (fallback)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Scoring threshold
AI_COMPOSITE_THRESHOLD=80
